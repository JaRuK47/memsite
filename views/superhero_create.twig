{% extends "__layout.twig" %}

{% block content %}
<h1>Добавление персонажа</h1>
<hr>

{% if message %}
<div class="alert alert-success">{{ message }} <a href="/superhero/{{ id }}">Открыть</a></div>
{% endif %}

<form method="POST" enctype="multipart/form-data" class="row g-3">
    <div class="col-4">
        <label class="form-label">Название</label>
        <input type="text" class="form-control" name="title" required>
    </div>
    <div class="col-4">
        <label class="form-label">Краткое описание</label>
        <input type="text" class="form-control" name="description" required>
    </div>
    <div class="col-4">
        <label class="form-label">Тип</label>
        <select class="form-control" name="type" required>
            {% for type in type_options %}
                <option value="{{ type.id }}">{{ type.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Картинка</label>
        <input type="file" class="form-control" name="image">
    </div>
    <div class="col-12">
        <textarea name="info" class="form-control" rows="5" placeholder="Полное описание"></textarea>
    </div>
    <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary">Добавить</button>
        <a href="/" class="btn btn-secondary">Отмена</a>
    </div>
</form>
{% endblock %}