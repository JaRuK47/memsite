<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fa-regular fa-face-angry"></i></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li>
                        <a class="nav-link" href="/">Главная</a>
                    </li>
                    {% for type in types %}
                    <li class="nav-item">
                        <a class="nav-link" href="/?type={{ type.type }}">{{ type.type|title }}</a>                    
                    </li>
                    {% endfor %}
                    <li class="nav-item">
                        <a class="nav-link" href="/search">Поиск</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/superhero/create">Добавить</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/type/add">Добавить тип</a>
                    </li>
                </ul>
                <form action="/set-welcome/" class="d-flex">
                    <input type="text" name="message" class="form-control me-2" placeholder="Введите сообщение"> 
                    <button type="submit" class="btn btn-primary">Туда</button>
                </form>
                <form action="/logout" method="POST" class="d-flex ms-2">
                    <button type="submit" class="btn btn-danger">Выйти</button>
                </form>
            </div>
        </div>
    </nav>
    
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-9">
                <div class="container">
                    {% block content %}
                        пустота
                    {% endblock %}
                </div>
            </div>
            
            <div class="col-md-3">
                {% if history|length > 0 %}
                <div class="card mt-3">
                    <div class="card-header">
                        <i class="fas fa-history"></i> Последние страницы
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for item in history %}
                        <li class="list-group-item">
                            <a href="{{ item.url }}">{{ item.url }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</body>

</html>